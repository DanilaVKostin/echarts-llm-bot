# Backend — you can put this file in the repo root or in backend/ (both are loaded).
BACKEND_HOST=localhost
BACKEND_PORT=9000

# --- Local LLM (Ollama, OpenAI-compatible) ---
LLM_LOCAL_BASE_URL=http://localhost:11434/v1
LLM_LOCAL_API_KEY=ollama
LLM_LOCAL_MODEL=qwen2.5:7b
LLM_LOCAL_MODEL_QWEN3_CODER_30B=qwen3-coder:30b

# --- OpenRouter (required for OpenRouter models) ---
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=your-key-here
OPENROUTER_MODEL_QWEN35_27B=qwen/qwen3.5-27b
OPENROUTER_MODEL_GPT4O=openai/gpt-4o

LLM_MAX_RETRIES=2
LLM_HTTP_TIMEOUT=120

# PostgreSQL — enables the SQL-data pipeline (optional)
# DATABASE_URL=postgresql://user:password@localhost:5432/your_db

# Frontend
VITE_API_BASE_URL=http://localhost:8000
